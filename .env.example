# ========================================
# Конфигурация приложения
# ========================================

# Окружение (development | production | test)
NODE_ENV=development

# Порт приложения
PORT=3000

# Хост для прослушивания (0.0.0.0 для Docker, localhost для локальной разработки)
HOST=0.0.0.0

# ========================================
# CORS настройки
# ========================================

# Разрешенные origins (* для всех или конкретный URL)
CORS_ORIGIN=*

# ========================================
# СпросиИИ API
# ========================================

# URL API СпросиИИ
ASKII_API_URL=https://api.sprosi.ai

# API ключ для доступа к СпросиИИ
ASKII_API_KEY=your_askii_api_key_here

# Timeout для запросов к API (в миллисекундах)
ASKII_TIMEOUT=30000

# ========================================
# Настройки бота
# ========================================

# Название бота
BOT_NAME=Научный Журнал Ассистент

# Язык бота
BOT_LANGUAGE=ru

# Максимальная длина ответа (в символах)
MAX_RESPONSE_LENGTH=2000

# ========================================
# Webhook настройки
# ========================================

# Секретный ключ для проверки подписи webhook (опционально)
WEBHOOK_SECRET=your_webhook_secret_here

# ========================================
# Безопасность
# ========================================

# JWT секретный ключ (если используется аутентификация)
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Время жизни токена (например: 1h, 7d, 30d)
JWT_EXPIRES_IN=7d

# ========================================
# Логирование
# ========================================

# Уровень логирования (error | warn | info | debug | verbose)
LOG_LEVEL=info

# Путь к файлам логов
LOG_PATH=./logs

# ========================================
# База данных (если потребуется)
# ========================================

# DATABASE_URL=postgresql://user:password@localhost:5432/journal_assistant
# REDIS_URL=redis://localhost:6379

# ========================================
# Дополнительные настройки
# ========================================

# Включить throttling (защита от спама)
ENABLE_THROTTLING=true

# Максимальное количество запросов в минуту
THROTTLE_TTL=60
THROTTLE_LIMIT=10
